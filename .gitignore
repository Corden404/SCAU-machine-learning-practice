# Ignore every file by default.
*

# Keep directories visible so nested Python files can be unignored.
!*/

# Track only Git ignore rules and Python source files.
!.gitignore
!*.py
!**/*.py

config/*.local.json
config/paths.local.json
config/paths.codex.local.json
data/
PetImages/
.trash/
presentation/
presentations/
__pycache__/
*.pyc
*.log
.claude/
